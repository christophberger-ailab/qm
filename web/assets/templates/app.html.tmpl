{{define "page"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quarto Manager</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/codemirror/codemirror.css">
  <link rel="stylesheet" href="/static/codemirror/dialog.css">
  <link rel="stylesheet" href="/static/codemirror/show-hint.css">
  <link rel="stylesheet" href="/static/app.css">
  <link rel="stylesheet" id="preview-css-link" href="/config/preview.css?file={{.ActiveCSS}}">
  <script src="/static/htmx.min.js"></script>
  <script src="/static/sortable.min.js"></script>
  <script src="/static/marked.umd.js"></script>
  {{/* CodeMirror carries the editor. Load order is the dependency order:
       the library, then the modes that compose into Quarto Markdown, then
       the addons and the vim keymap that build on both. */}}
  <script src="/static/codemirror/codemirror.js"></script>
  <script src="/static/codemirror/overlay.js"></script>
  <script src="/static/codemirror/xml.js"></script>
  <script src="/static/codemirror/meta.js"></script>
  <script src="/static/codemirror/yaml.js"></script>
  <script src="/static/codemirror/markdown.js"></script>
  <script src="/static/codemirror/gfm.js"></script>
  <script src="/static/codemirror/yaml-frontmatter.js"></script>
  <script src="/static/codemirror/dialog.js"></script>
  <script src="/static/codemirror/searchcursor.js"></script>
  <script src="/static/codemirror/matchbrackets.js"></script>
  <script src="/static/codemirror/continuelist.js"></script>
  <script src="/static/codemirror/vim.js"></script>
  <script src="/static/codemirror/show-hint.js"></script>
  <script src="/static/preview.js" defer></script>
  <script src="/static/editor.js" defer></script>
  <script src="/static/app.js" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>Quarto Manager</h1>
    <div id="open-panel">{{template "open-form" .}}</div>
    {{/* The field carries the request itself rather than sitting in a form:
         there is nothing to submit, the hits arrive while it is typed in,
         and htmx sends the value of the element that asks. */}}
    <div class="search-form">
      <input type="search" name="q" id="search-input" placeholder="Search pages" autocomplete="off"
             title="Highlight the pages containing every term. Quotes make a phrase: &quot;logging in&quot;"
             hx-get="/search" hx-trigger="input changed delay:300ms, search"
             hx-target="#search-results" hx-swap="innerHTML">
      <span id="search-results" class="search-results"></span>
    </div>
    <div id="render-panel">{{template "render" .}}</div>
    <div id="git-panel">{{template "git" .}}</div>
    <a class="button topbar-config" href="/config">Config</a>
  </header>
  <main class="panes" id="main">
    {{template "main" .}}
  </main>
</body>
</html>{{end}}

{{/* The Open field shows the last element of the project's path -- the
     folder name is what tells one project from another -- while the full
     path rides along in data-full and is what a submit sends. Typing or
     pasting into the field drops the full path (app.js), so a pasted path
     is opened as written. */}}
{{define "open-form"}}<form class="open-form" hx-post="/open" hx-target="#main" hx-swap="innerHTML">
  <div class="path-field">
    <input name="path" id="open-path" placeholder="/path/to/quarto/project" autocomplete="off"
           spellcheck="false" value="{{.Open.Label}}" data-full="{{.Open.Path}}"
           title="{{if .Open.Path}}{{.Open.Path}}{{else}}Path of the Quarto project to open{{end}}">
    {{if .Open.Recent}}<button type="button" class="path-menu-toggle" id="open-recent-toggle"
            aria-haspopup="listbox" aria-expanded="false" title="Recently opened projects">▾</button>
    <ul class="path-menu" id="open-recent" role="listbox" hidden>
      {{range .Open.Recent}}<li><button type="button" class="path-recent" role="option" data-path="{{.Path}}" title="{{.Path}}">{{.Label}}</button></li>
      {{end}}
    </ul>{{end}}
  </div>
  <button type="submit">Open</button>
</form>{{end}}

{{/* The Git panel is a popup like the render one. Its body is fetched when
     the panel opens rather than with the page: the working tree changes
     under the app all the time, and a status that was read minutes ago is
     worse than none. The trigger's filter keeps the close from asking
     again. */}}
{{define "git"}}{{if .Root}}<details class="git" id="git-details">
  <summary title="Show the changes since the last commit, stage them, commit, and push">Git</summary>
  <div class="git-body" id="git-body" hx-get="/git" hx-target="#git-body" hx-swap="innerHTML"
       hx-trigger="toggle[document.getElementById('git-details').open] from:#git-details"></div>
</details>{{end}}{{end}}

{{define "git-status"}}{{if .Error}}<div class="error">{{.Error}}</div>{{end}}
{{if .Message}}<div class="notice">{{.Message}}</div>{{end}}
{{if .Repo}}
<div class="git-branch">
  <span class="git-branch-name">{{.Branch}}</span>
  {{if .Upstream}}<span class="git-upstream">→ {{.Upstream}}</span>{{end}}
  {{if .Ahead}}<span class="git-ahead">{{.Ahead}} to push</span>{{end}}
  {{if .Behind}}<span class="git-behind">{{.Behind}} behind</span>{{end}}
</div>
{{if .Staged}}
<fieldset class="git-group">
  <legend>Staged <button type="button" class="git-all" hx-post="/git/unstage" hx-vals='{"all":"1"}' hx-target="#git-body" hx-swap="innerHTML">Unstage all</button></legend>
  <ul class="git-files">{{range .Staged}}<li class="git-file">
    <span class="git-code" title="{{.Description}}">{{.Code}}</span>
    <button type="button" class="git-path" title="{{.Description}} — show the diff"
            hx-get="/git/diff?path={{urlquery .Path}}&amp;staged=1" hx-target="#git-diff" hx-swap="innerHTML">{{.Path}}</button>
    <button type="button" hx-post="/git/unstage" hx-vals='{"path":"{{.Path}}"}' hx-target="#git-body" hx-swap="innerHTML">Unstage</button>
  </li>{{end}}</ul>
</fieldset>
{{end}}
{{if .Unstaged}}
<fieldset class="git-group">
  <legend>Not staged <button type="button" class="git-all" hx-post="/git/stage" hx-vals='{"all":"1"}' hx-target="#git-body" hx-swap="innerHTML">Stage all</button></legend>
  <ul class="git-files">{{range .Unstaged}}<li class="git-file">
    <span class="git-code" title="{{.Description}}">{{.Code}}</span>
    <button type="button" class="git-path" title="{{.Description}} — show the diff"
            hx-get="/git/diff?path={{urlquery .Path}}" hx-target="#git-diff" hx-swap="innerHTML">{{.Path}}</button>
    <button type="button" hx-post="/git/stage" hx-vals='{"path":"{{.Path}}"}' hx-target="#git-body" hx-swap="innerHTML">Stage</button>
  </li>{{end}}</ul>
</fieldset>
{{end}}
{{if and (not .Staged) (not .Unstaged)}}<p class="empty">No changes since the last commit.</p>{{end}}
{{/* The diff of the file last clicked. It sits inside the body, so every
     operation clears it: staging a file moves it to the other list, where
     its diff is a different one, and a diff left standing would be of a
     state that no longer exists. */ -}}
<div id="git-diff">{{if or .Staged .Unstaged}}<p class="empty git-diff-hint">Click a path to see its diff.</p>{{end}}</div>
<form class="git-commit" hx-post="/git/commit" hx-target="#git-body" hx-swap="innerHTML">
  <input name="message" id="git-message" placeholder="Commit message" autocomplete="off"{{if not .Staged}} disabled{{end}}>
  <button type="submit"{{if not .Staged}} disabled title="Stage a file to commit it"{{end}}>Commit</button>
</form>
<div class="git-actions">
  <button type="button" hx-post="/git/push" hx-target="#git-body" hx-swap="innerHTML"
          title="Push the commits of this branch to its remote">Push</button>
  <button type="button" hx-get="/git" hx-target="#git-body" hx-swap="innerHTML" title="Read the working tree again">↻ Refresh</button>
</div>
{{end}}
{{if .Output}}<pre class="git-output">{{.Output}}</pre>{{end}}{{end}}

{{/* One file's diff, shown for reading only: the Git panel is where the
     changes are looked over, and the editor is where they are made, so the
     pane's one way of changing anything is the button that opens the file
     there. */}}
{{define "git-diff"}}<div class="git-diff">
  <div class="git-diff-head">
    <span class="git-diff-path" title="{{.Path}}">{{.Path}}</span>
    <span class="git-diff-which">{{if .Staged}}staged{{else}}not staged{{end}}</span>
    {{if .Added}}<span class="git-diff-added">+{{.Added}}</span>{{end}}
    {{if .Removed}}<span class="git-diff-removed">−{{.Removed}}</span>{{end}}
    {{if .Editable}}<button type="button" class="git-diff-open" data-path="{{.EditPath}}" hx-get="/content?path={{urlquery .EditPath}}"
            hx-target="#content" hx-swap="innerHTML" title="Open this file in the editor">Open in editor</button>{{end}}
    <button type="button" class="git-diff-close" title="Close the diff" aria-label="Close the diff">✕</button>
  </div>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  {{/* Each line is a block of its own, so the lines are not separated by a
       newline as well: that would show the diff double-spaced. */ -}}
  {{if .Lines}}<pre class="git-diff-body">{{range .Lines}}<span class="git-dl git-dl-{{.Kind}}">{{.Text}}</span>{{end}}</pre>{{else if not .Error}}<p class="empty">Nothing to show: this side of the file has no textual change.</p>{{end}}
</div>{{end}}

{{define "render"}}{{with .Render}}{{if .Books}}<details class="render">
  <summary title="Build each selected topic into one flat document and render it">Render</summary>
  <div class="render-body">
    <form id="render-form" hx-post="/render/select" hx-trigger="change" hx-swap="none">
      {{range $book := .Books}}
      <fieldset class="book">
        <legend><label><input type="checkbox" name="book" value="{{$book.Name}}"{{if $book.Selected}} checked{{end}}> {{$book.Name}}</label></legend>
        {{if gt (len $book.Profiles) 1}}
        <div class="variants">
          {{range $book.Profiles}}<label class="profile" title="One quarto render run per checked audience"><input type="checkbox" name="profile.{{$book.Name}}" value="{{.Name}}"{{if .Selected}} checked{{end}}> {{.Name}}</label>
          {{end}}
        </div>
        {{else if eq (len $book.Profiles) 1}}
        {{range $book.Profiles}}<input type="hidden" name="profile.{{$book.Name}}" value="{{.Name}}">{{end}}
        {{else}}<span class="empty">no audiences</span>{{end}}
      </fieldset>
      {{end}}
      <fieldset class="formats">
        <legend>Formats</legend>
        {{range .Formats}}<label><input type="checkbox" name="format" value="{{.Name}}"{{if .Selected}} checked{{end}}> {{.Name}}</label>
        {{end}}
      </fieldset>
      <button type="button" id="render-run" hx-post="/render" hx-target="#render-log" hx-swap="innerHTML">Render</button>
    </form>
    <div id="render-log"></div>
  </div>
</details>{{end}}{{end}}{{end}}

{{define "render-log"}}<div{{if .Running}} hx-get="/render/status" hx-trigger="every 1s" hx-target="#render-log" hx-swap="innerHTML"{{end}}>
  {{if .Lines}}<pre class="render-output">{{range .Lines}}{{.}}
{{end}}</pre>{{end}}
  {{if .Running}}<span class="render-status running">Rendering…</span>
  {{else if .Failed}}<span class="render-status failed">Render failed</span>
  {{else if .Lines}}<span class="render-status ok">Done</span>{{end}}
</div>{{end}}

{{define "config-page"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quarto Manager Config</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <header class="topbar">
    <h1>Quarto Manager</h1>
    <nav class="topbar-nav"><a class="button" href="/">App</a></nav>
  </header>
  <main class="config-main">
    <h2>Config</h2>
    <p class="config-intro">Choose a configuration area.</p>
    <ul class="config-list">
      {{range .Entries}}<li>
        <a class="config-entry" href="{{.Href}}">
          <span class="config-entry-title">{{.Title}}</span>
          <span class="config-entry-description">{{.Description}}</span>
        </a>
      </li>{{end}}
    </ul>
  </main>
</body>
</html>{{end}}

{{define "preview-css-page"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Preview Custom CSS</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/codemirror/codemirror.css">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/codemirror/codemirror.js"></script>
  <script src="/static/codemirror/css.js"></script>
  <script src="/static/config.js" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>Quarto Manager</h1>
    <nav class="topbar-nav">
      <a class="button" href="/config">Config</a>
      <a class="button" href="/">App</a>
    </nav>
  </header>
  <main class="config-main">
    <h2>Preview: Custom CSS</h2>
    <p class="config-intro">Add CSS that should override the built-in Markdown preview styles.</p>
    <p class="config-intro">The stylesheet is loaded document-wide after the app's own stylesheet; scope rules with <code>.markdown-preview</code> to affect only the preview, for example <code>.markdown-preview h1 { color: rebeccapurple; }</code>.</p>
    {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
    {{if .Message}}<div class="notice">{{.Message}}</div>{{end}}
    {{if gt (len .Files) 1}}
    <form class="css-file-switch" method="get" action="/config/preview-css">
      <label for="css-file-select">Editing:</label>
      <select name="file" id="css-file-select" onchange="this.form.submit()">
        {{range .Files}}<option value="{{.}}"{{if eq . $.File}} selected{{end}}>{{.}}</option>{{end}}
      </select>
    </form>
    {{end}}
    <form class="config-editor" method="post" action="/config/preview-css" autocomplete="off">
      <input type="hidden" name="file" value="{{.File}}">
      {{/* Same two rules as the page editor: no browser restore over the
           stylesheet the server just sent, and a leading newline in the
           file survives the round trip. */ -}}
      <textarea name="css" class="preview-css-content" spellcheck="false" autocomplete="off">
{{.CSS}}</textarea>
      <div class="config-actions">
        <button type="submit">Save</button>
        <a class="button" href="/config">Back to Config</a>
        <a class="button" href="/">Back to App</a>
      </div>
    </form>
    <form class="css-new-file" method="post" action="/config/preview-css/new">
      <label for="css-new-name">Add an alternate stylesheet:</label>
      <input type="text" name="name" id="css-new-name" placeholder="dark.css" required>
      <button type="submit">Add stylesheet</button>
    </form>
  </main>
</body>
</html>{{end}}

{{define "main"}}{{if .Tree}}
<section id="tree-pane">
  <form class="new-file-form" hx-post="/create" hx-target="#tree" hx-swap="innerHTML">
    <input type="hidden" name="parent" value="">
    <input type="hidden" name="after" value="">
    <input name="name" placeholder="new-page" required>
    <input name="title" placeholder="Title">
    <button type="submit">＋ Page</button>
  </form>
  <div id="tree" hx-get="/watch" hx-trigger="every 2s" hx-swap="innerHTML">{{template "tree" .Tree}}</div>
  <div class="tree-toolbar">
    <button type="button" id="expand-all" title="Expand all branches" aria-label="Expand all branches">⊞</button>
    <button type="button" id="collapse-all" title="Collapse all branches" aria-label="Collapse all branches">⊟</button>
  </div>
</section>
<div id="divider" role="separator" aria-orientation="vertical" title="Drag to resize"></div>
<section id="content-pane"><div id="content">{{if .Page}}{{template "content" .Page}}{{else}}<p class="empty">Select a page to view its content.</p>{{end}}</div></section>
{{else}}
<section id="tree-pane"><p class="empty">Open a Quarto project to get started.</p></section>
<div id="divider" role="separator" aria-orientation="vertical" title="Drag to resize"></div>
<section id="content-pane"><div id="content"></div></section>
{{end}}{{end}}

{{define "tree"}}{{template "pages" group "" .Pages}}{{end}}

{{define "pages"}}<ul class="children" data-parent="{{.Parent}}">
{{range .Pages}}{{template "node" .}}{{end}}</ul>{{end}}

{{define "node"}}<li class="page {{if .Order}}ordered{{else}}unordered{{end}}{{if .BadFences}} bad-fences{{end}}{{if .Draft}} draft{{end}}{{if .Children}} has-children{{end}}" data-path="{{.Path}}" data-key="{{if .Path}}{{.Path}}{{else}}{{.Dir}}{{end}}">
  <div class="row">
    <span class="toggle" title="Collapse or expand"></span>
    {{if .Path}}<span class="drag-handle" title="Drag to move">⠿</span>{{end}}
    <span class="num"></span>
    {{if .Marker}}<span class="marker">{{.Marker}}</span>{{end}}
    {{if .Path}}<a class="title" href="#" hx-get="/content?path={{.Path}}" hx-target="#content">{{.Title}}</a>
    <button class="add" title="Add child page" hx-post="/create" hx-prompt="Name of the new page (without .qmd)" hx-vals='{"parent":"{{.Path}}"}' hx-target="#tree" hx-swap="innerHTML">＋</button>
    <button class="delete" title="Move to trash" hx-post="/delete" hx-vals='{"path":"{{.Path}}"}' hx-target="#tree" hx-swap="innerHTML" hx-confirm="Move {{.Path}} to the trash?">🗑</button>
    {{else}}<span class="title">{{.Title}}</span>{{end}}
  </div>
  {{template "pages" group .Path .Children}}
</li>{{end}}

{{define "treewrap"}}{{if .Error}}<div class="error">{{.Error}}</div>{{end}}{{template "tree" .Tree}}{{end}}

{{/* The hits are the pages the tree highlights, so they travel as data
     rather than as a result list of their own: app.js reads the paths and
     marks the matching tree entries. The summary is all the search field
     itself shows. */}}
{{define "search-results"}}<span class="search-summary"{{if .Indexing}} data-indexing="1"{{end}}>{{.Summary}}</span>
<ul class="search-hits" hidden>{{range .Hits}}<li data-path="{{.Path}}" data-count="{{.Count}}"></li>{{end}}</ul>{{end}}

{{define "content-heading"}}{{.Title}} <span class="path">{{.Path}}</span>{{end}}

{{/* content-path-oob re-points the open editor at a page whose file has
     just been renamed under it — a move into another book does that. Only
     the three places that name the path are swapped; the textarea is not
     among them, because it holds edits that still have to be saved, and
     the hidden field going first is what lets them be. */}}
{{define "content-path-oob"}}<input type="hidden" id="content-path" name="path" value="{{.Path}}" hx-swap-oob="true">
<h2 class="content-title" id="content-title" hx-swap-oob="true">{{template "content-heading" .}}</h2>
<button class="reload" id="content-reload" title="Reload from disk" hx-get="/content?path={{.Path}}&reload=1" hx-target="#content" hx-swap="innerHTML" hx-swap-oob="true">↻ Reload</button>{{end}}

{{define "content"}}<div class="content-header">
  <h2 class="content-title" id="content-title">{{template "content-heading" .}}</h2>
  <span class="save-status" id="save-status"></span>
  {{/* Shown only when a save was refused because the file changed on disk
       underneath. Refusing is what keeps somebody else's work; this is what
       keeps refusing from being a dead end. */ -}}
  <button type="button" class="save-overwrite" id="save-overwrite" hidden
          title="Write the editor's text over the file on disk, discarding the change made outside">Overwrite</button>
  <button type="button" class="preview-toggle" id="preview-toggle" aria-pressed="true" title="Show or hide the Markdown preview">👁 Preview</button>
  <button class="reload" id="content-reload" title="Reload from disk" hx-get="/content?path={{.Path}}&reload=1" hx-target="#content" hx-swap="innerHTML">↻ Reload</button>
</div>
<div class="editor-split">
  {{/* autocomplete="off" keeps the browser from putting the text a
       previous page left in this textarea back into it on a reload. The
       hidden path is not restored -- browsers skip hidden inputs -- so a
       restore would leave the editor showing one page's text under
       another page's name, and the first keystroke would autosave it
       over that other page. editor.js guards the same thing again for
       the browsers that restore anyway. */ -}}
  <form class="edit-form" autocomplete="off" hx-post="/save" hx-trigger="input delay:1s from:find textarea" hx-swap="none">
    <input type="hidden" id="content-path" name="path" value="{{.Path}}">
    {{/* The newline right after the tag is dropped by the HTML parser, so
         a page whose text starts with one keeps it instead of losing it on
         the next save. */ -}}
    <textarea name="body" class="file-content" autocomplete="off">
{{.Body}}</textarea>
    {{/* The vim toggle sits below the editor and inside the editor's own
         column: it belongs to the text it acts on, and a button under the
         text is out of the way of the text. CodeMirror mounts on the
         textarea and puts itself in the textarea's place, so the toggle
         stays below the editor either way. */ -}}
    <div class="editor-toolbar">
      <button type="button" class="vim-toggle" id="vim-toggle" aria-pressed="false" title="Vim keybindings in the editor">⌨ Vim Mode</button>
    </div>
  </form>
  <div id="preview-divider" role="separator" aria-orientation="vertical" title="Drag to resize"></div>
  <div class="preview-column" id="preview-column">
    {{/* The column beside the editor is tabbed: the Markdown preview of
         the page, and the copyediting tool that works on the same text.
         Both read what the editor holds, so they are two views of one
         thing rather than two places; app.js remembers which of them was
         last looked at. */ -}}
    <div class="pane-tabs" role="tablist">
      <button type="button" class="pane-tab" data-tab="preview" role="tab" aria-selected="true"
              aria-controls="preview" title="The page as Quarto would roughly render it">Preview</button>
      <button type="button" class="pane-tab" data-tab="copyedit" role="tab" aria-selected="false"
              aria-controls="copyedit" title="Run an editing task over this page">Copyedit</button>
    </div>
    <article class="markdown-preview pane-panel" id="preview" role="tabpanel"></article>
    {{template "copyedit" .Copyedit}}
    {{/* Below the preview: the two buttons that page through the book, and
         the stylesheet the preview is shown in. Both describe the preview
         rather than the text, so they sit under the preview's own column.
         The buttons start disabled and app.js enables the ones that lead
         somewhere -- it reads the tree for the pages before and after this
         one, which is also what keeps them right while the tree changes
         under the editor. */ -}}
    <div class="preview-footer">
      <div class="page-nav">
        <button type="button" class="page-flip" id="page-prev" disabled
                title="The page before this one">◀ Previous</button>
        <button type="button" class="page-flip" id="page-next" disabled
                title="The page after this one">Next ▶</button>
      </div>
      {{if gt (len .CSSFiles) 1}}
      <select id="preview-css-select" class="preview-css-select" title="Switch the custom CSS applied to the preview">
        {{range .CSSFiles}}<option value="{{.}}"{{if eq . $.ActiveCSS}} selected{{end}}>{{.}}</option>{{end}}
      </select>
      {{end}}
    </div>
  </div>
</div>{{end}}

{{/* The copyedit tab. Its head carries the model the tasks are run on --
     the connections are configured once, and which of them answers is a
     choice made here, beside the work. Its body holds either the list of
     editing tasks or the suggestions the last run came back with; one
     replaces the other, and the Back button brings the list again. */}}
{{define "copyedit"}}<section class="copyedit pane-panel" id="copyedit" role="tabpanel" hidden>
  <div class="copyedit-head">
    {{if .Connections}}<label for="copyedit-connection">Model</label>
    <select id="copyedit-connection" class="copyedit-connection" title="The API connection the editing tasks are run on">
      {{range .Connections}}<option value="{{.ID}}"{{if .Active}} selected{{end}} title="{{.Kind}} · {{.BaseURL}}">{{.Name}} ({{.Model}})</option>
      {{end}}
    </select>
    {{else}}<span class="empty">No model configured — <a href="/config/connections">add an API connection</a>.</span>{{end}}
  </div>
  <div id="copyedit-body">{{template "copyedit-prompts" .}}</div>
</section>{{end}}

{{/* The editing tasks, by title alone: the prompt itself is what the task
     is made of, not what it is picked by, so it rides along as the
     tooltip. A click sends the page the editor holds -- its text, not the
     file, so unsaved edits are edited too -- and swaps this list for the
     suggestions. */}}
{{define "copyedit-prompts"}}<div class="copyedit-prompts">
  {{if .Prompts}}<ul class="copyedit-tasks">
    {{/* Two ways to start a run, because they cost differently. Clicking
         a task runs that one. Ticking several and pressing Run selected
         puts them in one call, which sends the page once instead of once
         per task -- the page is the bulk of what a run costs, and the
         tasks are what the user picked, so nothing is asked for that was
         not. */ -}}
    {{range .Prompts}}<li class="copyedit-task-row">
      <input type="checkbox" class="copyedit-select" name="prompt" value="{{.ID}}"
             id="pick-{{.ID}}" title="Run this task together with the others ticked">
      <button type="button" class="copyedit-task" data-id="{{.ID}}" title="{{.Prompt}}"
              hx-post="/copyedit/run" hx-vals='{"prompt":"{{.ID}}"}'
              hx-include="#content-path, #content textarea.file-content"
              hx-target="#copyedit-body" hx-swap="innerHTML"
              hx-indicator="#copyedit-running" hx-disabled-elt=".copyedit-task, #copyedit-run-selected">{{.Title}}</button>
    </li>
    {{end}}
  </ul>
  <div class="copyedit-run-actions">
    <button type="button" id="copyedit-run-selected" class="copyedit-run-selected" disabled
            title="Run every ticked task in one call"
            hx-post="/copyedit/run"
            hx-include="#content-path, #content textarea.file-content, #copyedit-body .copyedit-select:checked"
            hx-target="#copyedit-body" hx-swap="innerHTML"
            hx-indicator="#copyedit-running" hx-disabled-elt=".copyedit-task, #copyedit-run-selected">Run selected</button>
  </div>
  {{else}}<p class="empty">No editing tasks yet — write them under <a href="/config/copyedit">Config → Copyedit: Editing tasks</a>.</p>{{end}}
  <p class="copyedit-running" id="copyedit-running">Asking the model…</p>
</div>{{end}}

{{/* What one run came back with, grouped by the task each suggestion
     answers. The ones found in the page carry the position they were
     found at, which is what app.js highlights the text by and what a
     click on the entry scrolls the editor to; the ones that say what to
     put there instead offer to write it in. Every entry offers Done,
     which is how a suggestion carried out by hand -- in the editor,
     rather than by the button -- is taken off the list and out of the
     text. */}}
{{define "copyedit-suggestions"}}<div class="copyedit-suggestions">
  <div class="copyedit-suggestions-head">
    <button type="button" class="copyedit-back" id="copyedit-back" title="Back to the editing tasks"
            hx-get="/copyedit/prompts" hx-target="#copyedit-body" hx-swap="innerHTML">◀ Tasks</button>
    <span class="copyedit-task-name">{{if .Tasks}}{{len .Tasks}} task{{if gt (len .Tasks) 1}}s{{end}}, {{.Count}} suggestion{{if ne .Count 1}}s{{end}}{{end}}</span>
    {{if .Model}}<span class="copyedit-model" title="The model this run went to, and how it was carried out">{{.Model}}{{if .Mode}} · {{.Mode}}{{end}}</span>{{end}}
  </div>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  {{/* One filter per task, for a run of several: the whole run is on
       screen at once, and a chip narrows it to the task being worked
       through. */ -}}
  {{if gt (len .Groups) 1}}<div class="copyedit-filters" id="copyedit-filters">
    <button type="button" class="copyedit-filter active" data-task="">All</button>
    {{range .Groups}}<button type="button" class="copyedit-filter" data-task="{{.Task}}">{{if .Task}}{{.Task}}{{else}}Unattributed{{end}} ({{len .Suggestions}})</button>
    {{end}}
  </div>{{end}}
  {{range .Groups}}<section class="copyedit-group" data-task="{{.Task}}">
    {{if gt (len $.Groups) 1}}<h3 class="copyedit-group-name">{{if .Task}}{{.Task}}{{else}}Unattributed{{end}}</h3>{{end}}
    {{if .Suggestions}}<ol class="copyedit-list">
      {{range .Suggestions}}<li class="copyedit-suggestion{{if not .Located}} unlocated{{end}}"
          {{if .Located}}data-start="{{.Start}}" data-end="{{.End}}" title="Scroll the editor to this passage"{{end}}
          {{if .Applicable}}data-replacement="{{.Replacement}}"{{end}}>
        <blockquote class="copyedit-original">{{.Original}}</blockquote>
        {{if .Replacement}}<p class="copyedit-replacement">{{.Replacement}}</p>{{end}}
        {{if .Comment}}<p class="copyedit-comment">{{.Comment}}</p>{{end}}
        {{if not .Located}}<p class="copyedit-unlocated">Not found in the page as quoted, so it is not highlighted.</p>{{end}}
        {{/* Apply writes the suggestion in; Done says it was dealt with
             by hand. Only a suggestion with a passage and a replacement
             can be written in, but any of them can be finished with. */ -}}
        <div class="copyedit-suggestion-actions">
          {{if .Applicable}}<button type="button" class="copyedit-apply"
                  title="Replace the passage in the editor with this text">Apply</button>{{end}}
          <button type="button" class="copyedit-done"
                  title="Mark as dealt with — takes it off the list and unhighlights the passage">Done</button>
        </div>
      </li>
      {{end}}
    </ol>
    {{else if not $.Error}}<p class="empty copyedit-none">Nothing to change.</p>{{end}}
  </section>
  {{end}}
  {{if and (not .Groups) (not .Error)}}<p class="empty">Nothing to change: the model had no suggestion.</p>{{end}}
</div>{{end}}

{{define "copyedit-page"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Copyedit: Editing tasks</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/config.js" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>Quarto Manager</h1>
    <nav class="topbar-nav">
      <a class="button" href="/config">Config</a>
      <a class="button" href="/">App</a>
    </nav>
  </header>
  <main class="config-main">
    <h2>Copyedit: Editing tasks</h2>
    <p class="config-intro">An editing task is a prompt with a title. The copyedit tab beside the editor lists the titles; picking one sends the open page to the selected model and shows what it suggests.</p>
    <p class="config-intro">Write the prompt as an instruction about the page — "Find sentences in the passive voice and rewrite them actively". The answer's shape is asked for by the app, so the prompt only has to say what to look for.</p>
    {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
    {{if .Message}}<div class="notice">{{.Message}}</div>{{end}}
    <form class="config-form config-setting" method="post" action="/config/copyedit/mode">
      <h3>Running several tasks</h3>
      <p class="config-intro">Ticking several tasks in the pane can go to the model either way. One call sends the page once and is cheaper; one call per task lets the model attend to each task on its own, and may read better. The page is the cached part of a request, so from the second call on a provider that caches serves it without charging full price for it again — which is what makes the per-task way affordable enough to be worth comparing.</p>
      <label>Mode<select name="mode">
        <option value="batched"{{if not .PerTask}} selected{{end}}>One call for all ticked tasks</option>
        <option value="per-task"{{if .PerTask}} selected{{end}}>One call per ticked task</option>
      </select></label>
      <div class="config-actions"><button type="submit">Save mode</button></div>
    </form>
    <ul class="config-items">
      {{range .Prompts}}<li class="config-item">
        <form class="config-form" method="post" action="/config/copyedit" autocomplete="off">
          <input type="hidden" name="id" value="{{.ID}}">
          <label>Title<input type="text" name="title" value="{{.Title}}" required></label>
          {{/* No newline between tag and value: the parser drops the first
               one, and a prompt would lose its leading blank line. */ -}}
          <label>Prompt<textarea name="prompt" rows="5" spellcheck="false" required>{{.Prompt}}</textarea></label>
          <div class="config-actions">
            <button type="submit">Save</button>
            <button type="submit" class="danger" formaction="/config/copyedit/delete"
                    formnovalidate title="Remove this editing task">Delete</button>
          </div>
        </form>
      </li>
      {{end}}
    </ul>
    <form class="config-form config-new" method="post" action="/config/copyedit" autocomplete="off">
      <h3>Add an editing task</h3>
      <label>Title<input type="text" name="title" placeholder="Passive voice" required></label>
      <label>Prompt<textarea name="prompt" rows="5" spellcheck="false"
              placeholder="Find sentences in the passive voice and rewrite them in the active voice." required></textarea></label>
      <div class="config-actions"><button type="submit">Add task</button></div>
    </form>
    <div class="config-actions">
      <a class="button" href="/config">Back to Config</a>
      <a class="button" href="/">Back to App</a>
    </div>
  </main>
</body>
</html>{{end}}

{{define "connections-page"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Copyedit: API connections</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/config.js" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>Quarto Manager</h1>
    <nav class="topbar-nav">
      <a class="button" href="/config">Config</a>
      <a class="button" href="/">App</a>
    </nav>
  </header>
  <main class="config-main">
    <h2>Copyedit: API connections</h2>
    <p class="config-intro">A connection is one model the editing tasks can be run on: which API it speaks, where it lives, which model to ask, and the key it takes. Several may be configured; the copyedit tab picks between them.</p>
    <p class="config-intro">"Anthropic" posts to <code>&lt;base URL&gt;/messages</code>, "OpenAI-compatible" to <code>&lt;base URL&gt;/chat/completions</code> — which is what OpenAI, Ollama, LM Studio, and OpenRouter all speak. A local model usually needs no key.</p>
    <p class="config-intro">Give the base URL — <code>https://api.openai.com/v1</code>, <code>https://openrouter.ai/api/v1</code>, <code>http://localhost:11434/v1</code> — or paste the whole endpoint your provider's documentation prints: the path above is added only when it is not already there.</p>
    <p class="config-intro">The keys are stored in <code>copyedit.json</code> beside the render preferences, readable by you alone, and are never sent back to the browser.</p>
    {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
    {{if .Message}}<div class="notice">{{.Message}}</div>{{end}}
    <ul class="config-items">
      {{range .Connections}}<li class="config-item">
        <form class="config-form" method="post" action="/config/connections" autocomplete="off">
          <input type="hidden" name="id" value="{{.ID}}">
          <label>Name<input type="text" name="name" value="{{.Name}}" required></label>
          <label>API<select name="kind">
            <option value="anthropic"{{if eq .Kind "anthropic"}} selected{{end}}>Anthropic</option>
            <option value="openai"{{if ne .Kind "anthropic"}} selected{{end}}>OpenAI-compatible</option>
          </select></label>
          <label>Base URL<input type="text" name="base_url" value="{{.BaseURL}}" spellcheck="false" required></label>
          <label>Model<input type="text" name="model" value="{{.Model}}" spellcheck="false" required></label>
          <label>API key<input type="password" name="key" autocomplete="new-password"
                  placeholder="{{if .HasKey}}stored — leave empty to keep it{{else}}none stored{{end}}"></label>
          <div class="config-actions">
            <button type="submit">Save</button>
            <button type="submit" class="danger" formaction="/config/connections/delete"
                    formnovalidate title="Remove this connection">Delete</button>
          </div>
        </form>
      </li>
      {{end}}
    </ul>
    <form class="config-form config-new" method="post" action="/config/connections" autocomplete="off">
      <h3>Add a connection</h3>
      <label>Name<input type="text" name="name" placeholder="Claude" required></label>
      <label>API<select name="kind">
        <option value="anthropic">Anthropic</option>
        <option value="openai">OpenAI-compatible</option>
      </select></label>
      <label>Base URL<input type="text" name="base_url" placeholder="https://api.anthropic.com/v1" spellcheck="false" required></label>
      <label>Model<input type="text" name="model" placeholder="claude-sonnet-4-5" spellcheck="false" required></label>
      <label>API key<input type="password" name="key" autocomplete="new-password" placeholder="sk-..."></label>
      <div class="config-actions"><button type="submit">Add connection</button></div>
    </form>
    <div class="config-actions">
      <a class="button" href="/config">Back to Config</a>
      <a class="button" href="/">Back to App</a>
    </div>
  </main>
</body>
</html>{{end}}
